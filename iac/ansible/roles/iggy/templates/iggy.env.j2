# /etc/iggy/iggy.env — 0600，凭据由 ansible-vault 渲染，勿手改（重跑 playbook 会覆盖）
IGGY_TCP_ADDRESS=0.0.0.0:{{ iggy_tcp_port }}
IGGY_HTTP_ADDRESS=0.0.0.0:{{ iggy_http_port }}
IGGY_ROOT_USERNAME={{ iggy_root_username | default('admin') }}
IGGY_ROOT_PASSWORD={{ vault_iggy_password }}
# 数据目录不走 env：由下方 server.toml 的 data_dir 任务渲染（Iggy 配置面以 server.toml 为准）
