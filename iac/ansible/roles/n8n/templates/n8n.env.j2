# /etc/slr/n8n.env — 0600，vault 渲染，勿手改
# n8n 核心
N8N_USER_FOLDER={{ n8n_user_folder }}
N8N_ENCRYPTION_KEY={{ vault_n8n_encryption_key }}
N8N_PORT={{ n8n_port }}
N8N_METRICS=true
N8N_DIAGNOSTICS_ENABLED=false
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
GENERIC_TIMEZONE=UTC
TZ=UTC
PATH=/opt/node/bin:/usr/local/bin:/usr/bin:/bin
# SLR 运行时变量（workflow $env 读取；默认值见 n8n/README.md）
SLR_TRADING_PAIRS={{ trading_pairs }}
SLR_PROM_URL=http://localhost:{{ prometheus_port }}
SLR_LANCER_URL=http://localhost:8003
SLR_QUERY_API_URL=http://localhost:{{ query_api_port }}
SLR_IGGY_HTTP_URL=http://{{ data_ip }}:{{ iggy_http_port }}
SLR_IGGY_USER={{ iggy_root_username | default('admin') }}
SLR_IGGY_PASSWORD={{ vault_iggy_password }}
SLR_GRAFANA_URL=http://localhost:{{ grafana_port }}
SLR_LLM_MODEL={{ slr_llm_model | default('qwen-plus') }}
