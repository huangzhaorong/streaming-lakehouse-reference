[Unit]
Description=Apache Fluss TabletServer {{ fluss_version }}
After=network-online.target fluss-coordinator.service
Wants=network-online.target
Requires=fluss-coordinator.service

[Service]
Type=simple
User=fluss
Environment=JAVA_HOME=/usr/lib/jvm/java-21-openjdk
Environment=FLUSS_CONF_DIR=/etc/fluss/tablet
Environment=FLUSS_LOG_DIR=/var/log/fluss
ExecStart=/opt/fluss/bin/tablet-server.sh start-foreground
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
